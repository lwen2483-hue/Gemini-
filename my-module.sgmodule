#!name=我的自定义合并规则
#!desc=包含本地内网、GEOIP国内直连、Sub-Store、Speedtest、农行屏蔽及苹果OTA控制规则
#!icon=https://raw.githubusercontent.com/Orz-3/mini/master/Color/Xair.png

[Rule]
# ===== 0. 强制优先级（最高，必须放在最前） =====
DOMAIN-SUFFIX,sentry.io,REJECT
DOMAIN-SUFFIX,weixin.qq.com,DIRECT
DOMAIN-SUFFIX,douyinvod.com,DIRECT
DOMAIN,js.appds.vip,漏网之鱼
DOMAIN,app-analytics-services.com,REJECT

# ===== 1. 核心本地/审计与阻断（高优先级） =====
IP-CIDR,127.0.0.1/32,DIRECT,no-resolve
DOMAIN,msmp.abchina.com.cn,REJECT

# ===== 2. 苹果系统更新与诊断控制（可根据需求修改 REJECT） =====
# 如果需要正常更新系统，请将下方的 REJECT 改为 DIRECT 或你的代理策略名
DOMAIN,gdmf.apple.com,REJECT
DOMAIN,mesu.apple.com,REJECT
DOMAIN,updates-http.cdn-apple.com,REJECT
DOMAIN,xp.apple.com,REJECT


# ===== 2.1. 苹果服务强制直连（解决 iCloud DNS 解析超时） =====
DOMAIN-SUFFIX,apple.com,DIRECT
DOMAIN-SUFFIX,icloud.com,DIRECT
DOMAIN-SUFFIX,icloud-content.com,DIRECT
DOMAIN-SUFFIX,cdn-apple.com,DIRECT
DOMAIN-SUFFIX,apple-dns.net,DIRECT
DOMAIN-SUFFIX,token.safebrowsing.apple,REJECT,no-resolve


# ===== 3. IPv4 保留 / 内网 / 特殊地址直连 =====

# ===== 4. IPv6 本地 / 保留地址直连 =====


# ===== 5. 国内域名与局域网解析 =====
DOMAIN-SUFFIX,local,DIRECT
DOMAIN-SUFFIX,lan,DIRECT
DOMAIN-SUFFIX,home.arpa,DIRECT
DOMAIN-SUFFIX,cn,DIRECT
DOMAIN-SUFFIX,speedtest.cn,DIRECT

# ===== 6. 特定域名走代理 =====